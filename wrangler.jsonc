{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedding-card",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wdcard.enmsoftware.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "GUESTBOOK_DB",
      "database_name": "wedding-card-guestbook-db",
      "database_id": "d085b8fc-4b33-4cf5-a56e-ba62573c5ec8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEDDING_MEDIA",
      "bucket_name": "wedding-card-media"
    }
  ],
  "ratelimits": [
    {
      "name": "GUESTBOOK_RATE_LIMITER",
      "namespace_id": "42617",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "ADMIN_AUTH_MODE": "cloudflare-access-jwt",
    "REQUIRE_GUESTBOOK_RATE_LIMIT": "1"
  }
}
